{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D512 eval test-set case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "gold", "reading", "context", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "gold": {"type": "string", "minLength": 2, "maxLength": 32},
    "reading": {
      "type": "array", "minItems": 2, "maxItems": 32,
      "items": {"type": "string", "pattern": "^[ㄅ-ㄩ]{1,3}[ˊˇˋ˙]?$"}
    },
    "context": {"type": "string"},
    "source": {"type": "string", "minLength": 1}
  },
  "$comment": "跨欄位 gold 字數 == reading 長度及分割去重條件，由 validate.py 檢查。"
}
